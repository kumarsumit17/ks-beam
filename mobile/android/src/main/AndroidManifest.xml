<?xml version="1.0" encoding="utf-8"?>
<!-- The phone app: the sender. Permissions and the application come from :shared; a separate
     Google TV app (tv/google-tv, the receiver) has the same package name. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- While a cast runs the phone is the TV's file server (CastService): a foreground service
         with media controls, a wake lock and Wi-Fi locks keep it reachable with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <application>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share a video, song or photo to KS Beam from another app: it is cast. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="video/*" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <service
            android:name=".CastService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
